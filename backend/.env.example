# Optional. Copy to `.env` to override defaults from app/config.py.
# Every key below maps to a field on the Settings class — anything else is
# ignored rather than rejected, so a typo will not stop the app starting.
#
# The app runs correctly with NO .env file at all. Only create one if you
# want to change an assumption.

# --- Economic assumptions -------------------------------------------------
# These condition every profit and loss figure the product reports.
# Changing them means your results will no longer match docs/NUMBERS.md.

# Share of principal unrecovered on default. An assumption, not a measurement.
LOSS_GIVEN_DEFAULT=0.65

# Current-state policy used as the comparison baseline: approve at or above
# this credit score, ignoring all other signals.
LEGACY_CREDIT_SCORE_CUTOFF=600

# Minimum share of transactions that must stay approved for a strategy to be
# considered commercially shippable.
MIN_APPROVAL_RATE_PCT=75.0

# --- Dataset --------------------------------------------------------------
# Changing any of these requires regenerating data AND retraining the model.

N_CUSTOMERS=5000
N_TRANSACTIONS=42000
RANDOM_SEED=42

# --- Simulation -----------------------------------------------------------

THRESHOLD_GRID_MIN=0.005
THRESHOLD_GRID_MAX=0.65
CV_FOLDS=5

# --- App ------------------------------------------------------------------

DEBUG=true

# NOTE: the API host and port are NOT settings. They are uvicorn arguments:
#   uvicorn app.main:app --host 127.0.0.1 --port 8000
